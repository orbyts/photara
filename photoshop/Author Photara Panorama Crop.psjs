const { app, constants, core } = require("photoshop");
const { storage } = require("uxp");

const MANIFEST_NAME = "Photara Panorama Crop Manifest.json";

async function child(folder, relativePath) {
  let entry = folder;
  for (const component of relativePath.split("/").filter(Boolean)) {
    entry = await entry.getEntry(component);
  }
  return entry;
}

function pixels(value) {
  return Math.round(Number(value && value._value !== undefined ? value._value : value));
}

async function main() {
  await core.showAlert(
    "Choose the Photara project folder. Photara will open the panorama source and place a centered 3:2 selection representing two adjacent 3:4 frames."
  );
  const projectRoot = await storage.localFileSystem.getFolder();
  if (!projectRoot) return;
  let manifestEntry;
  try { manifestEntry = await projectRoot.getEntry(MANIFEST_NAME); }
  catch (_) { throw new Error(`Could not find ${MANIFEST_NAME} in “${projectRoot.name}”.`); }
  const manifest = JSON.parse(await manifestEntry.read());
  if (manifest.schema_version !== 1 || manifest.crop_aspect_ratio !== "3:2") {
    throw new Error("Unsupported Photara panorama crop manifest");
  }
  const source = await child(projectRoot, manifest.source_relative_path);
  let document = null;
  await core.executeAsModal(async () => {
    document = await app.open(source);
    const width = pixels(document.width);
    const height = pixels(document.height);
    let cropWidth = width;
    let cropHeight = Math.round(width / 1.5);
    if (cropHeight > height) {
      cropHeight = height;
      cropWidth = Math.round(height * 1.5);
    }
    const left = Math.round((width - cropWidth) / 2);
    const top = Math.round((height - cropHeight) / 2);
    await document.selection.selectRectangle(
      { left, top, right: left + cropWidth, bottom: top + cropHeight },
      constants.SelectionType.REPLACE,
      0,
      false
    );
  }, { commandName: `Author panorama crop for ${manifest.item_id}` });
  await core.showAlert(
    "The 3:2 crop represents two horizontal 3:4 frames. Use Select > Transform Selection to position or resize it, keeping a 3:2 ratio. Do not crop or save the source. When satisfied, run Capture Photara Panorama Crop; it will place the seam guide at the current crop midpoint."
  );
}

try {
  await main();
} catch (error) {
  await core.showAlert(error && error.message ? error.message : String(error));
  throw error;
}
