const { app, action, constants, core } = require("photoshop");
const { storage } = require("uxp");

const MANIFEST_NAME = "photara-master-manifest.json";
const REPORT_NAME = "photara-photoshop-report.json";

async function child(folder, relativePath) {
  let entry = folder;
  for (const component of relativePath.split("/").filter(Boolean)) {
    entry = await entry.getEntry(component);
  }
  return entry;
}

async function parentAndName(folder, relativePath) {
  const components = relativePath.split("/").filter(Boolean);
  const name = components.pop();
  let parent = folder;
  for (const component of components) {
    parent = await parent.getEntry(component);
  }
  return { parent, name };
}

async function openAsSmartObject(file) {
  const token = storage.localFileSystem.createSessionToken(file);
  const result = await action.batchPlay(
    [{
      _obj: "open",
      null: { _path: token, _kind: "local" },
      smartObject: true,
    }],
    {}
  );
  if (result[0] && result[0]._obj === "error") {
    throw new Error(result[0].message || "Photoshop could not open the DNG");
  }
  return app.activeDocument;
}

async function smartObjectEvidence() {
  const result = await action.batchPlay(
    [{
      _obj: "get",
      _target: [
        { _ref: "layer", _enum: "ordinal", _value: "targetEnum" },
        { _ref: "document", _enum: "ordinal", _value: "targetEnum" },
      ],
    }],
    {}
  );
  const descriptor = result[0] || {};
  const smart = descriptor.smartObject;
  return {
    smartObject: Boolean(smart),
    linked: smart ? Boolean(smart.linked) : null,
    fileReference: smart && smart.fileReference ? smart.fileReference : null,
  };
}

function bitDepth(document) {
  if (document.bitsPerChannel === constants.BitsPerChannelType.SIXTEEN) return 16;
  if (document.bitsPerChannel === constants.BitsPerChannelType.THIRTYTWO) return 32;
  if (document.bitsPerChannel === constants.BitsPerChannelType.EIGHT) return 8;
  return null;
}

function isP3Pq(profile) {
  const value = String(profile || "").toLowerCase();
  return value.includes("p3") && value.includes("pq");
}

async function processItem(root, item) {
  let document = null;
  try {
    const dng = await child(root, item.dng_relative_path);
    const destination = await parentAndName(root, item.psb_relative_path);
    let existing = null;
    try { existing = await destination.parent.getEntry(destination.name); } catch (_) {}
    if (existing) {
      await core.executeAsModal(async () => {
        document = await app.open(existing);
      }, { commandName: `Verify ${item.psb_filename}` });
      const evidence = await smartObjectEvidence();
      const depth = bitDepth(document);
      const profile = document.colorProfileName;
      if (depth !== 16 || !isP3Pq(profile)) {
        throw new Error(`Existing PSB does not satisfy 16-bit P3 PQ: ${depth}, ${profile}`);
      }
      if (!evidence.smartObject || evidence.linked !== false) {
        throw new Error("Existing PSB does not contain an embedded Smart Object");
      }
      if (evidence.fileReference !== item.dng_filename) {
        throw new Error(`Existing Smart Object source mismatch: ${evidence.fileReference}`);
      }
      await core.executeAsModal(async () => document.closeWithoutSaving(), {
        commandName: `Close ${item.psb_filename}`,
      });
      document = null;
      return {
        asset_id: item.asset_id,
        dng_filename: item.dng_filename,
        psb_filename: item.psb_filename,
        state: "verified",
        bits_per_channel: depth,
        color_profile: profile,
        smart_object: evidence.smartObject,
        linked: evidence.linked,
        file_reference: evidence.fileReference,
      };
    }

    await core.executeAsModal(async () => {
      document = await openAsSmartObject(dng);
    }, { commandName: `Open ${item.dng_filename} as Smart Object` });

    const evidence = await smartObjectEvidence();
    const depth = bitDepth(document);
    const profile = document.colorProfileName;
    if (depth !== 16) throw new Error(`Expected 16 bits/channel, got ${depth}`);
    if (!isP3Pq(profile)) throw new Error(`Expected a P3 PQ profile, got ${profile}`);
    if (!evidence.smartObject || evidence.linked !== false) {
      throw new Error("The DNG did not open as an embedded Smart Object");
    }
    if (evidence.fileReference !== item.dng_filename) {
      throw new Error(`Smart Object source mismatch: ${evidence.fileReference}`);
    }

    const psb = await destination.parent.createFile(destination.name, { overwrite: false });
    await core.executeAsModal(async () => {
      await document.saveAs.psb(psb, { embedColorProfile: true }, false);
    }, { commandName: `Save ${item.psb_filename}` });

    const result = {
      asset_id: item.asset_id,
      dng_filename: item.dng_filename,
      psb_filename: item.psb_filename,
      state: "verified",
      bits_per_channel: depth,
      color_profile: profile,
      smart_object: evidence.smartObject,
      linked: evidence.linked,
      file_reference: evidence.fileReference,
    };
    await core.executeAsModal(async () => document.closeWithoutSaving(), {
      commandName: `Close ${item.psb_filename}`,
    });
    document = null;
    return result;
  } catch (error) {
    if (document) {
      try {
        await core.executeAsModal(async () => document.closeWithoutSaving(), {
          commandName: "Close failed Photara master",
        });
      } catch (_) {}
    }
    return {
      asset_id: item.asset_id,
      dng_filename: item.dng_filename,
      psb_filename: item.psb_filename,
      state: "failed",
      error: error && error.message ? error.message : String(error),
    };
  }
}

async function main() {
  const root = await storage.localFileSystem.getFolder();
  if (!root) return;
  const workspace = await root.getEntry(".photara");
  const manifestEntry = await workspace.getEntry(MANIFEST_NAME);
  const manifest = JSON.parse(await manifestEntry.read());
  const report = {
    schema_version: 1,
    batch_id: manifest.batch_id,
    project: manifest.project,
    items: [],
  };
  for (const item of manifest.items) {
    report.items.push(await processItem(root, item));
  }
  const reportEntry = await workspace.createFile(REPORT_NAME, { overwrite: true });
  await reportEntry.write(`${JSON.stringify(report, null, 2)}\n`);
  const verified = report.items.filter((item) => item.state === "verified").length;
  const failed = report.items.length - verified;
  await core.showAlert(
    `Photara master build finished.\n\nVerified: ${verified}\nFailed: ${failed}\n\nPhotara will verify the report before registering anything.`
  );
}

await main();
