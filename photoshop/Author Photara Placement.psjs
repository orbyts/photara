const { app, constants, core } = require("photoshop");
const { storage } = require("uxp");

const MANIFEST_NAME = "Photara Authoring Manifest.json";

async function child(folder, relativePath) {
  let entry = folder;
  for (const component of relativePath.split("/").filter(Boolean)) {
    entry = await entry.getEntry(component);
  }
  return entry;
}

function pixels(value) {
  return Math.round(Number(value && value._value !== undefined ? value._value : value));
}

async function rotateSource(document, quarterTurnsClockwise) {
  if (quarterTurnsClockwise === 0) return;
  await document.rotate(quarterTurnsClockwise * 90);
}

function contextName(index, placement) {
  const platform = placement.authoring_platform ? ` ${placement.authoring_platform}` : "";
  return `Photara ${String(index + 1).padStart(3, "0")} ${placement.item_id} ${placement.slot}${platform}`;
}

function orderedPlacements(manifest) {
  const primary = manifest.placements.map(placement => ({
    ...placement,
    authoring_platform: manifest.schema_version === 2 ? manifest.platform : null,
  }));
  const secondary = manifest.secondary && Array.isArray(manifest.secondary.placements)
    ? manifest.secondary.placements.map(placement => ({
        ...placement,
        authoring_platform: manifest.secondary.platform,
      }))
    : [];
  return primary.concat(secondary);
}

async function main() {
  await core.showAlert(
    "Choose the Photara project folder. Photara will open the authored source and place a target-aspect selection."
  );
  const projectRoot = await storage.localFileSystem.getFolder();
  if (!projectRoot) return;
  const manifestEntry = await projectRoot.getEntry(MANIFEST_NAME);
  const manifest = JSON.parse(await manifestEntry.read());
  const placements = orderedPlacements(manifest);
  if (![1, 2].includes(manifest.schema_version) || placements.length < 1) {
    throw new Error("Photara authoring manifest has no placements");
  }
  for (let index = 0; index < placements.length; index += 1) {
    const placement = placements[index];
    const source = await child(projectRoot, placement.source_relative_path);
    await core.executeAsModal(async () => {
      const opened = await app.open(source);
      const document = await opened.duplicate(contextName(index, placement), false);
      await opened.closeWithoutSaving();
      await rotateSource(document, placement.transform.rotation_quarter_turns_cw || 0);
      const width = pixels(document.width);
      const height = pixels(document.height);
      const targetRatio = placement.target_bounds.width / placement.target_bounds.height;
      let cropWidth;
      let cropHeight;
      let left;
      let top;
      if (placement.transform.crop) {
        left = Math.round(placement.transform.crop.x * width);
        top = Math.round(placement.transform.crop.y * height);
        cropWidth = Math.round(placement.transform.crop.width * width);
        cropHeight = Math.round(placement.transform.crop.height * height);
      } else {
        cropWidth = width;
        cropHeight = Math.round(width / targetRatio);
        if (cropHeight > height) {
          cropHeight = height;
          cropWidth = Math.round(height * targetRatio);
        }
        left = Math.round((width - cropWidth) / 2);
        top = Math.round((height - cropHeight) / 2);
      }
      await document.selection.selectRectangle(
        { left, top, right: left + cropWidth, bottom: top + cropHeight },
        constants.SelectionType.REPLACE,
        0,
        false
      );
    }, { commandName: `Author ${placement.item_id} ${placement.slot}` });
  }
  await core.showAlert(
    `Photara opened ${placements.length} ordered placement contexts. Transform each ` +
    `selection while preserving its aspect ratio. Do not crop or save these contexts. When all ` +
    `are ready, run Capture Photara Placement once.`
  );
}

try {
  await main();
} catch (error) {
  await core.showAlert(error && error.message ? error.message : String(error));
  throw error;
}
