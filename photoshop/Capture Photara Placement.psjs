const { app, core } = require("photoshop");
const { storage } = require("uxp");

const MANIFEST_NAME = "Photara Authoring Manifest.json";
const REPORT_NAME = "Photara Authoring Report.json";

function pixels(value) {
  return Math.round(Number(value && value._value !== undefined ? value._value : value));
}

function normalized(value, total) {
  return Number((value / total).toFixed(12));
}

function contextName(index, placement) {
  return `Photara ${String(index + 1).padStart(3, "0")} ${placement.item_id} ${placement.slot}`;
}

function documentStem(document) {
  return String(document.name || "").replace(/\.[^.]+$/, "");
}

async function main() {
  await core.showAlert("Choose the same Photara project folder to capture the active selection.");
  const projectRoot = await storage.localFileSystem.getFolder();
  if (!projectRoot) return;
  const manifestEntry = await projectRoot.getEntry(MANIFEST_NAME);
  const manifest = JSON.parse(await manifestEntry.read());
  if (manifest.schema_version !== 1 || manifest.placements.length < 1) {
    throw new Error("Photara authoring manifest has no placements");
  }
  const results = [];
  for (let index = 0; index < manifest.placements.length; index += 1) {
    const placement = manifest.placements[index];
    const expectedName = contextName(index, placement);
    const document = app.documents.find(candidate => documentStem(candidate) === expectedName);
    if (!document) throw new Error(`Could not find authoring context “${expectedName}”.`);
    const bounds = document.selection.bounds;
    if (!bounds || !document.selection.solid) {
      throw new Error(`${expectedName} must contain one solid rectangular selection.`);
    }
    const documentWidth = pixels(document.width);
    const documentHeight = pixels(document.height);
    const left = pixels(bounds.left);
    const top = pixels(bounds.top);
    const right = pixels(bounds.right);
    const bottom = pixels(bounds.bottom);
    if (left < 0 || top < 0 || right > documentWidth || bottom > documentHeight) {
      throw new Error(`${expectedName} selection must stay inside its source.`);
    }
    results.push({
      item_id: placement.item_id,
      slot: placement.slot,
      asset_id: placement.asset_id,
      source_sha256: placement.source_sha256,
      document_width: documentWidth,
      document_height: documentHeight,
      transform: {
        crop: {
          x: normalized(left, documentWidth),
          y: normalized(top, documentHeight),
          width: normalized(right - left, documentWidth),
          height: normalized(bottom - top, documentHeight),
        },
        rotation_quarter_turns_cw: placement.transform.rotation_quarter_turns_cw || 0,
      },
    });
  }
  const report = {
    schema_version: 1,
    session_id: manifest.session_id,
    project: manifest.project,
    post: manifest.post,
    platform: manifest.platform,
    source_specification_sha256: manifest.source_specification_sha256,
    authoring_input_sha256: manifest.authoring_input_sha256,
    placements: results,
  };
  const reportEntry = await projectRoot.createFile(REPORT_NAME, { overwrite: true });
  await reportEntry.write(`${JSON.stringify(report, null, 2)}\n`);
  await core.showAlert(`Captured ${results.length} ordered placements. Return to Photara to apply them.`);
}

try {
  await main();
} catch (error) {
  await core.showAlert(error && error.message ? error.message : String(error));
  throw error;
}
